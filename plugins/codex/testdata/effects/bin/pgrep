#!/usr/bin/env sh
# The pane's found child is a distinct process from the pane's own root
# (PLECT_EFFECT_PID, what { terminal = "pid" } resolves to), so a scenario
# can assert a kill-on-failure path took this one and left the pane alone.
plect-effect-record pgrep "$@"
printf '%s\n' "$PLECT_EFFECT_WORKER_PID"
