#!/usr/bin/env bash
# codex-headless runtime worker: the sole consumer of a session's queue
# directory. Runs as an ordinary child of the pane's shell (not exec'd), so
# a stuck worker can be terminated by its own pid without ending the pane's
# root process — `codex exec` has no input box to wedge, so this still
# needs no TUI-boot detection.
#
# Turns are drained strictly serially (one `codex exec`/`codex exec resume`
# at a time) so a kick arriving mid-turn queues instead of racing the
# running one. The first turn has no thread_id yet; its `thread.started`
# JSONL line seeds state_dir/thread_id for every subsequent resume.
#
# Usage: codex-exec-worker <queue_dir> <state_dir> <profile_name>

set -u

queue_dir="${1:?queue_dir required}"
state_dir="${2:?state_dir required}"
profile_name="${3:?profile_name required}"

mkdir -p "$queue_dir" "$state_dir/log"

# A bash script's own pid is not recoverable from its process name (comm is
# the interpreter's, "bash", regardless of the script file executed), so this
# is the only way the owning task's setup can identify — and later
# terminate — this specific worker instance.
printf '%s' "$$" > "$state_dir/worker.pid"

# CODEX_MODEL / CODEX_MODEL_REASONING_EFFORT (set by tasks/exec_runtime.toml's
# setup from the model/effort inputs) map onto codex's own `-m` / `-c
# model_reasoning_effort=` flags — empty means codex's config default, not a
# flag override.
extra_args=()
[ -n "${CODEX_MODEL:-}" ] && extra_args+=(-m "$CODEX_MODEL")
[ -n "${CODEX_MODEL_REASONING_EFFORT:-}" ] && extra_args+=(-c "model_reasoning_effort=$CODEX_MODEL_REASONING_EFFORT")

# Marks the worker loop as reachable before the first turn ever runs; the
# owning task's setup polls this file instead of a TUI-readiness heuristic.
touch "$state_dir/ready"

write_health() {
    local exit_code="$1" event_type="$2"
    local tmp
    tmp="$(mktemp "$state_dir/.health.XXXXXX")"
    jq -n --argjson code "$exit_code" --arg type "$event_type" --arg ts "$(date +%s)" \
        '{last_exit_code: $code, last_event_type: $type, last_ts: ($ts | tonumber)}' > "$tmp"
    mv "$tmp" "$state_dir/health.json"
}

agent_activity() {
    local event="$1" activity="$2"
    [ -n "${PLECT_SESSION_NAME:-}" ] || return 0
    # PLECT_AGENT_ACTIVITY_BIN (set by tasks/exec_runtime.toml's setup via
    # a `bin` reference) is the resolved absolute path; this script runs as a
    # standalone process outside plect's own resolution, so it cannot
    # resolve a `bin` reference itself. Fall back to PATH for a caller that
    # launched this worker without setting it.
    printf '{"hook_event_name":"%s"}\n' "$event" \
        | "${PLECT_AGENT_ACTIVITY_BIN:-codex-agent-activity}" "$activity" >/dev/null 2>&1 || true
}

tick_session() {
    [ -n "${PLECT_SESSION_NAME:-}" ] || return 0
    plect tick "$PLECT_SESSION_NAME" >/dev/null 2>&1 || true
}

while true; do
    for f in "$queue_dir"/*.json; do
        [ -e "$f" ] || continue

        event_type="$(jq -r '.type' "$f" 2>/dev/null || true)"
        text="$(jq -r '.text' "$f" 2>/dev/null || true)"
        if [ -z "$text" ]; then
            rm -f "$f"
            continue
        fi

        thread_id="$(cat "$state_dir/thread_id" 2>/dev/null || true)"
        log_file="$state_dir/log/$(date +%s%N).jsonl"
        last_message_file="$(mktemp "$state_dir/.last-message.XXXXXX")"

        agent_activity "UserPromptSubmit" "working"
        if [ -z "$thread_id" ]; then
            codex exec --json --profile "$profile_name" \
                --dangerously-bypass-approvals-and-sandbox \
                --output-last-message "$last_message_file" \
                "${extra_args[@]}" \
                -- "$text" > "$log_file" 2>&1
        else
            # `codex exec resume`, unlike `codex exec`, rejects --profile on
            # some codex-cli releases ("unexpected argument", exit 2) — omit
            # it here so a resumed turn still runs on those releases.
            codex exec resume --json \
                --dangerously-bypass-approvals-and-sandbox \
                --output-last-message "$last_message_file" \
                "${extra_args[@]}" \
                "$thread_id" -- "$text" > "$log_file" 2>&1
        fi
        exit_code=$?

        if [ -z "$thread_id" ] && [ "$exit_code" -eq 0 ]; then
            new_thread_id="$(jq -r 'select(.type == "thread.started") | (.thread_id // .payload.thread_id // empty)' "$log_file" 2>/dev/null | head -1)"
            [ -n "$new_thread_id" ] && printf '%s' "$new_thread_id" > "$state_dir/thread_id"
        fi

        write_health "$exit_code" "$event_type"
        mv "$last_message_file" "$state_dir/last-message.txt"
        # Round-trip the turn's reply onto the event bus so it reaches any
        # subscriber (a web UI, a chat channel, ...), symmetric with the
        # inbound enqueue channel. A dedicated `codex.reply` event type
        # avoids a self-feedback loop with this same channel. Publish on
        # success with a non-empty reply only; failures already surface via
        # health.json.
        if [ -n "${PLECT_SESSION_NAME:-}" ] && [ "$exit_code" -eq 0 ]; then
            reply="$(cat "$state_dir/last-message.txt" 2>/dev/null || true)"
            [ -n "$reply" ] && plect event publish "$PLECT_SESSION_NAME" \
                --type codex.reply --summary "codex turn reply" --body "$reply" \
                >/dev/null 2>&1 || true
        fi
        rm -f "$f"
        agent_activity "Stop" "waiting"
        tick_session
    done
    sleep 1
done
