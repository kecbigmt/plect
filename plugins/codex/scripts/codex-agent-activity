#!/usr/bin/env bash
# Codex CLI turn-boundary activity: the record half is a hook, the read
# half is this task's `[health].activity` probe, so one executable owns both
# ends of one fingerprint format. It also owns reply, the publisher of an
# agent's own text as the core plect.message event: Codex's `codex exec`/
# `codex exec resume` expose no per-message streaming hook, so unlike the
# Claude plugin's counterpart this has no message_display side — same
# one-executable reason.
#
# Usage:
#   codex-agent-activity working|waiting              # hook; session from $PLECT_SESSION_NAME
#   codex-agent-activity reply                        # publishes plect.message from stdin JSON
#   codex-agent-activity probe <session> [state_dir]  # activity probe; writes the envelope
#   codex-agent-activity reset <session>               # drop the record (setup/cleanup)
#
# working/waiting read a Codex hook's own event JSON from stdin; reply reads
# whatever JSON its caller built (a Codex hook's payload has the same
# last_assistant_message/turn_id shape, but exec_runtime's worker calls
# reply directly with its own --output-last-message capture instead of
# registering a hook — see that task's setup for why). All three are
# fire-and-forget by design: a failure here must never fail the agent's
# turn, so every exit path is 0. The probe path only fails loud (non-zero
# exit, no stdout) when the session name itself is missing — an unreadable
# or torn hook record degrades to "no hook evidence" instead, since the
# log-file signal below can still carry the probe on its own.

set -u

# A session name carries a slash (owner/repo-1), which cannot appear in a
# path component.
record_path() {
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/plect/codex-activity"
  printf '%s/%s.json' "$dir" "$(printf '%s' "$1" | tr '/' '_')"
}

# reply_seq_path backs the fallback branch of reply's message_id: a counter
# that keeps the synthetic id deterministic even on the one turn boundary
# Stop exposes no turn_id for (before this process's first user input).
reply_seq_path() {
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/plect/codex-activity"
  printf '%s/%s.reply-seq' "$dir" "$(printf '%s' "$1" | tr '/' '_')"
}

# publish_report fires the same event-shape rule the reporting hook follows:
# empty text publishes nothing, and a non-empty one goes out with a
# first-line summary. Never fails the caller — a publish failure is silently
# swallowed, per the fire-and-forget contract this hook operates under.
publish_report() {
  local event_type="$1" text="$2" firstline
  shift 2
  [ -n "$text" ] || return 0
  firstline="$(printf '%s' "$text" | head -n 1)"
  plect event publish "$PLECT_SESSION_NAME" --type "$event_type" --summary "${firstline:0:120}" --body "$text" "$@" >/dev/null 2>&1
  return 0
}

# jq_field_exact sets $REPLY to one jq filter's raw output byte-for-byte from
# the captured $payload, including any trailing newlines: a sentinel byte
# anchors the value's real end, since `$(...)` command substitution strips
# every trailing newline unconditionally — silently dropping it from a
# message that ends in one. This is why it is never called as
# `x="$(jq_field_exact ...)"`: capturing this function's own stdout would
# hit that exact same loss one layer further out. Follow the `read`/$REPLY
# convention instead: call it, then read $REPLY as a plain assignment, which
# strips nothing.
jq_field_exact() {
  local out
  out="$(printf '%s' "$payload" | jq -j "($1) + \"\"" 2>/dev/null)" || out=$'\001'
  REPLY="${out%$'\001'}"
}

# The turn-boundary hooks only fire at a turn's start and end, so a single
# long-running `codex exec` — whose stdout is redirected into this file,
# never the pane — produces no evidence for its entire duration. The tmux
# pane fingerprint that pairs with an interactive agent's turn-boundary
# probe for exactly this reason (see plugins/tmux's pane.toml) cannot cover
# for it here, since that pane never repaints. The turn's own log file
# (one per turn, named at turn start, growing as codex streams to it) is
# the only signal this runtime produces in between: its name changing marks
# a new turn, and its size changing marks one still in progress.
latest_log_fingerprint() {
  local state_dir="$1" latest size
  [ -n "$state_dir" ] && [ -d "$state_dir/log" ] || return 0
  latest="$(ls -t "$state_dir/log" 2>/dev/null | head -n 1)"
  [ -n "$latest" ] || return 0
  size="$(wc -c < "$state_dir/log/$latest" 2>/dev/null | tr -d ' ')"
  printf '%s:%s' "$latest" "$size"
}

case "${1:-}" in
  probe)
    session="${2:-}"
    state_dir="${3:-}"
    [ -n "$session" ] || { echo "probe: session name required" >&2; exit 1; }
    file="$(record_path "$session")"

    hook_fp=""
    silence_expected="false"
    observed_at=""
    if [ -f "$file" ]; then
      hook_fp="$(jq -r '.fingerprint // empty' "$file" 2>/dev/null)" || hook_fp=""
      silence_expected="$(jq -r '(.silence_expected // false)' "$file" 2>/dev/null)" || silence_expected="false"
      observed_at="$(jq -r '.observed_at // empty' "$file" 2>/dev/null)" || observed_at=""
    fi

    log_fp="$(latest_log_fingerprint "$state_dir")"

    # Neither source has crossed a boundary yet — no evidence to report,
    # which is exit 0 with empty stdout, not a stall.
    [ -n "$hook_fp$log_fp" ] || exit 0
    [ -n "$observed_at" ] || observed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    jq -nc \
      --arg fp "hook=${hook_fp}|log=${log_fp}" \
      --argjson silence "$silence_expected" \
      --arg at "$observed_at" \
      '{fingerprint: $fp, silence_expected: $silence, observed_at: $at}'
    exit 0
    ;;
  reset)
    session="${2:-}"
    # The reply-seq counter is deliberately not touched here: setup calls
    # reset on every launch, resumes included, and exec_runtime's reply has
    # no turn_id to fall back from, ever — that counter is message_id's only
    # source for this runtime's entire session lifetime, so restarting it
    # would mint an id a prior turn already published.
    [ -n "$session" ] && rm -f "$(record_path "$session")"
    exit 0
    ;;
  reply)
    [ -n "${PLECT_SESSION_NAME:-}" ] || exit 0
    payload="$(cat)"

    # Extracted via jq_field_exact, not a plain `$(...)` read: a real
    # assistant message routinely contains newlines, which `$(...)` would
    # strip if they were trailing.
    jq_field_exact '.last_assistant_message // empty'
    message="$REPLY"
    [ -n "$message" ] || exit 0

    turn_id="$(printf '%s' "$payload" | jq -r '.turn_id // empty' 2>/dev/null)" || turn_id=""

    # message_id is a deterministic synthetic id, per the core contract, not
    # a random one: a caller with its own per-turn id (a real Codex hook)
    # doubles it as the id. exec_runtime's worker has no such id to give —
    # every turn is its own `codex exec` call, and Codex's own turn_id lives
    # only inside its Stop hook payload, which this call path never receives
    # — so the counter fallback is that caller's every call, not an edge
    # case.
    if [ -n "$turn_id" ]; then
      message_id="$PLECT_SESSION_NAME/$turn_id"
    else
      seq_file="$(reply_seq_path "$PLECT_SESSION_NAME")"
      n="$(cat "$seq_file" 2>/dev/null)"
      case "$n" in ''|*[!0-9]*) n=0 ;; esac
      mkdir -p "$(dirname "$seq_file")" 2>/dev/null
      printf '%s' "$((n + 1))" > "$seq_file" 2>/dev/null
      message_id="$PLECT_SESSION_NAME/reply-$n"
    fi

    meta=(--meta "message_id=$message_id" --meta "message_id_origin=synthetic" --meta "role=assistant" --meta "source=codex")
    [ -n "$turn_id" ] && meta+=(--meta "turn_id=$turn_id")
    publish_report plect.message "$message" "${meta[@]}"
    exit 0
    ;;
esac

activity="${1:-}"

if [ -z "${PLECT_SESSION_NAME:-}" ] || [ -z "$activity" ]; then
  exit 0
fi

event="$(jq -r '.hook_event_name // ""' 2>/dev/null)" || event=""

text="$activity"
[ -n "$event" ] && text="$activity (codex $event)"

# The waiting phase marks a completed turn, not an activity: an idle session
# is reported as an empty message, not the literal word "waiting".
[ "$activity" = "waiting" ] && text=""

plect state set-message "$PLECT_SESSION_NAME" "$text" >/dev/null 2>&1

file="$(record_path "$PLECT_SESSION_NAME")"
mkdir -p "$(dirname "$file")" 2>/dev/null
# A counter, not a timestamp: two boundaries inside the same second must
# still produce two distinct fingerprints, or core reads the second one as
# "no change" and starts a stall clock against a session that just moved.
seq="$(jq -r '.seq // 0' "$file" 2>/dev/null)" || seq=0
case "$seq" in ''|*[!0-9]*) seq=0 ;; esac
# Only a turn known to have ended establishes that quiet is intended, so only
# that case pardons silence; anything else declines to pardon.
case "$activity" in
  waiting) silence_expected=true ;;
  *)       silence_expected=false ;;
esac
# A temp-file-then-rename, not a direct redirect: `> "$file"` truncates
# before jq produces a byte of output, so a probe reading in that window
# would see (and fail to parse) an empty file instead of the record it
# replaced. rename is atomic, so a concurrent probe only ever sees the old
# record or the new one, never neither.
tmp="$(mktemp "$(dirname "$file")/.activity.XXXXXX" 2>/dev/null)" || exit 0
jq -nc \
  --arg activity "$activity" \
  --argjson silence_expected "$silence_expected" \
  --argjson seq "$((seq + 1))" \
  --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{seq: $seq, silence_expected: $silence_expected, fingerprint: "\($activity):\($seq)", observed_at: $at}' \
  > "$tmp" 2>/dev/null && mv "$tmp" "$file" || rm -f "$tmp"

exit 0
